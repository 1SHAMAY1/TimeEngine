// 6. ALL MEMORY SAFETY VIOLATIONS (NEW, DELETE, C-ALLOC) COMBINATIONS
// =============================================================================

// A. Direct new and new[] combinations
void TestRawNewCombinations() {
    int* p1 = new int(10);
    int* p2 = new int[20];
    auto* p3 = new float(3.14f);
    auto* p4 = new double[5];
    char* p5 = new char('a');
    bool* p6 = new bool(true);

    int** ptrToPtr = &p1;
    *ptrToPtr = new int(55);

    // B. Direct delete and delete[] combinations
    delete p1;
    delete[] p2;
    delete p3;
    delete[] p4;
    delete p5;
    delete[] p6;
}

// C. C-Style allocations: malloc, calloc, realloc, free
void* HeaderAlloc_Malloc(size_t size) {
    return malloc(size);
}

void* HeaderAlloc_Calloc(size_t num, size_t size) {
    return calloc(num, size);
}

void* HeaderAlloc_Realloc(void* ptr, size_t newSize) {
    return realloc(ptr, newSize);
}

void HeaderAlloc_Free(void* ptr) {
    free(ptr);
}

void TestCAllocationsCombination() {
    void* m = malloc(256);
    void* c = calloc(32, sizeof(int));
    void* r = realloc(m, 512);
    free(c);
    free(r);
}

