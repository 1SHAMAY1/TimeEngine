// 7. INLINE CLASS METHODS WITH RAW NEW / DELETE / C-ALLOC COMBINATIONS
// =============================================================================
class HeaderInlineRuleBreaker {
public:
    HeaderInlineRuleBreaker() {
        // Raw new combinations
        m_RawInt = new int(10);
        m_RawArray = new int[50];
        auto* autoNewPtr = new double(3.14);
        int* localPtr = new int(99);
        *m_DerefTarget = new float(1.23f);

        // Raw delete combinations
        delete m_RawInt;
        delete[] m_RawArray;
        delete autoNewPtr;
        delete localPtr;
        delete this;

        // C allocation combinations
        m_CAllocMem = malloc(128);
        m_CCallocMem = calloc(16, 4);
        m_CReallocMem = realloc(m_CAllocMem, 256);
        free(m_CCallocMem);
        free(m_CReallocMem);

        // Std smart pointer factory functions
        auto u = std::make_unique<int>(10);
        auto s = std::make_shared<int>(20);
        auto bu = make_unique<float>(1.0f);
        auto bs = make_shared<float>(2.0f);

        // Namespace violations
        ::TE::GlobalInit();
        ::TimeEngine::StaticSetup();
        TimeEngine::DirectCall();
        Timeengine::LegacyCall();
        TE::Renderer::Clear();

        // Legacy TEString path methods
        TEString tePath = "C:/Assets/Texture.png";
        tePath.stem();
        tePath.filename();
        tePath.parent_path();
        tePath.has_parent_path();
        tePath.extension();
        tePath.replace_extension(".dds");

        // std::getline
        getline(std::cin, m_StringMember);
    }

    virtual ~HeaderInlineRuleBreaker() {
        delete m_RawInt;
        delete[] m_RawArray;
        free(m_CAllocMem);
    }

private:
    int* m_RawInt = new int(0);
    int* m_RawArray = new int[10];
    float** m_DerefTarget = nullptr;
    void* m_CAllocMem = nullptr;
    void* m_CCallocMem = nullptr;
    void* m_CReallocMem = nullptr;

    std::unique_ptr<int> m_MemberUnique;
    unique_ptr<int> m_MemberBareUnique;
    std::shared_ptr<int> m_MemberShared;
    shared_ptr<int> m_MemberBareShared;
    std::weak_ptr<int> m_MemberWeak;
    weak_ptr<int> m_MemberBareWeak;

    std::vector<int> m_MemberStdVector;
    vector<int> m_MemberBareVector;
    std::unordered_map<int, int> m_MemberStdMap;
    unordered_map<int, int> m_MemberBareMap;
    std::unordered_set<int> m_MemberStdSet;
    unordered_set<int> m_MemberBareSet;

    std::string m_StringMember;
    std::wstring m_WStringMember;
    std::u8string m_U8StringMember;
    std::u16string m_U16StringMember;
    std::u32string m_U32StringMember;
    string m_BareStringMember;
    wstring m_BareWStringMember;
    u8string m_BareU8StringMember;

    char32_t m_Char32Member;
    char16_t m_Char16Member;
    wchar_t m_WCharMember;

    std::filesystem::path m_FsPathMember;
};
