# ==============================================================================
# TimeEngine Repository .gitignore
# ==============================================================================

# Centralized Build Outputs & Intermediates
Artifacts/
Bin/
Bin-Intermediate/
Build_Release/
Build_Development/
**/build/
**/bin/
**/obj/

# Compiled Binaries & Libraries
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.pdb
*.ilk
*.exp
*.obj
*.idb
*.tlog

# Premake Standalone Binaries (Downloaded by SetupSubmodules)
ThirdParty/Premake/Windows/
ThirdParty/Premake/Mac/
ThirdParty/Premake/Linux/
Vendor/Premake/Windows/
Vendor/Premake/Mac/
Vendor/Premake/Linux/

# GNU Make & Visual Studio / IDE Generated Files
Makefile
*.make
*.sln
*.vcxproj
*.vcxproj.filters
.vs/
*.user
*.vcxproj.user
*.sln.DotSettings.user
recent_projects.txt

# JetBrains IDEs
.idea/
.Rider*/

# Xcode & macOS Metadata
*.xcodeproj/
*.xcworkspace/
*.xe
.DS_Store
TimeEditor/Info.plist

# ImGui Layouts & Editor Runtime Temp Files
Config/
/Config/
*.ini
imgui.ini
temp_viewport_capture.png
*.bak

# Engine Runtime Logs
**/*_TimeEngineLog.json
Client_TimeEngineLog.json
Core_TimeEngineLog.json

# Whitelist Critical Repository Folders
!.agents/
!.agents/**
!.github/
!.github/**
!.vscode/
!.vscode/**

# Generated Reports & Python Cache (from local CI script testing)
__pycache__/
*.py[cod]
.github/reports/
